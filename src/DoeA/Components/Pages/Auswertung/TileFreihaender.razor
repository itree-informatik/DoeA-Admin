@using DoeA.Interfaces.Auswertungen
@inject IAuswertungService AuswertungService
@inject IJSRuntime JsRuntime
@inherits BaseComponent

<TileTitle TitleKey="AUSWERTUNG_TILE_FREIHAENDER"/>

<TileDatumBereich LabelKey="AUSWERTUNG_TILE_FREIHAENDER_PUBLIKATIONSDATUM"
                  @bind-Von="_datumVon" @bind-Bis="_datumBis" />

<div class="d-flex d-flex-column gap-3 mb-2">
    <div class="tile-label">
        <label class="form-label">@TranslationHelper.Translate("AUSWERTUNG_TILE_ZUSCHLAEGE_VERFAHRENSART")</label>
    </div>
    <TileCheckbox @bind-Wert="_isFreihaendig" LabelKey="AUSWERTUNG_TILE_ZUSCHLAEGE_VERFAHRENSART_FREIHAENDIG" />
</div>
<div class="d-flex d-flex-column gap-3 mb-2">
    <div class="tile-label">
        <label class="form-label">@TranslationHelper.Translate("AUSWERTUNG_TILE_ZUSCHLAEGE_PROJEKTART")</label>
    </div>
    <TileCheckbox @bind-Wert="_isLogistik" LabelKey="AUSWERTUNG_TILE_ZUSCHLAEGE_PROJEKTART_LOGISTIK" />
    <TileCheckbox @bind-Wert="_isBau" LabelKey="AUSWERTUNG_TILE_ZUSCHLAEGE_PROJEKTART_BAU" />
</div>
<div class="d-flex d-flex-column gap-3 mb-2">
    <div class="tile-label">
        <label class="form-label">@TranslationHelper.Translate("AUSWERTUNG_TILE_AUSSCHREIBUNGEN_ROLLE_BBL")</label>
    </div>
    <TileCheckbox @bind-Wert="_isAemterDezentral" LabelKey="AUSWERTUNG_TILE_AUSSCHREIBUNGEN_ROLLE_BBL_MELDESTELLE" />
    <TileCheckbox @bind-Wert="_isLogistikZentral" LabelKey="AUSWERTUNG_TILE_AUSSCHREIBUNGEN_ROLLE_BBL_VERGABESTELLE" />
</div>
<div class="d-flex d-flex-column gap-2">
    <ItreeButton Icon="@MudBlazor.Icons.Material.Filled.TableChart"
                 ButtonTextKey="AUSWERTUNG_TILE_FREIHAENDER_EXCEL_ERSTELLEN"
                 ShowButtonText="true"
                 OnClick="CreateExcel"
                 Enabled="@(IstGueltig && !_isCreating)"
                 SpinnerIsLoading="@_isCreating"/>
</div>

@code {
    /// <summary>Meldet der Seite, dass sich der Filter geändert hat.</summary>
    [Parameter]
    public EventCallback Refresh { get; set; }

    private bool _isAemterDezentral = true;
    private bool _isBau = true;
    private bool _isCreating;
    private bool _isFreihaendig = true;
    private bool _isLogistik = true;
    private bool _isLogistikZentral = true;

    private DateTime? _datumBis = DateTime.Now;
    private DateTime? _datumVon = new DateTime(DateTime.Now.Year, 1, 1);

    // Aus jeder der drei Filtergruppen muss mindestens ein Wert gewählt sein, sonst wäre die
    // Ergebnismenge zwangsläufig leer.
    private bool IstGueltig =>
        _isFreihaendig &&
        (_isLogistik || _isBau) &&
        (_isAemterDezentral || _isLogistikZentral) &&
        TileDatumBereich.IstGueltig(_datumVon, _datumBis);

    private async Task CreateExcel()
    {
        if (!IstGueltig || _isCreating)
        {
            return;
        }

        _isCreating = true;
        StateHasChanged();

        await ErrorHandler.HandleAsync(async () =>
        {
            var id = await AuswertungService.GetFreihaenderAsync(
                DateOnly.FromDateTime(_datumVon!.Value),
                DateOnly.FromDateTime(_datumBis!.Value),
                _isFreihaendig, _isLogistik, _isBau, _isAemterDezentral, _isLogistikZentral);
            await DownloadFileFromStream(JsRuntime, new Guid(id));
        });

        _isCreating = false;
    }
}
