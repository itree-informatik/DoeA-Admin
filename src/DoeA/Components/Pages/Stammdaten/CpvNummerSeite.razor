@using DoeA.Data.Models.DTO.Stammdaten
@using DoeA.Validator.Stammdaten
@using DoeA.Interfaces.Stammdaten
@inherits EditComponent<CpvNummer, ICpvNummerService>

@if (DataList == null)
{
    <ItreeSpinner />
}
else
{
    <ItreeGrid TItem="CpvNummer" Data="FilteredList" Pageable="true" PageSize="@PageSize" PageSizes="@PageSizeOptions"
               Sortable="true" FilterMode="ItreeGridFilterMode.FilterMenu" OnRowClick="@OnRowClick">
        <GridToolBarTemplate>
            <ItreeSearchbox Id="searchbox" OnClick="@LoadData" Placeholder="@TranslationHelper.Translate("AUSWAEHLEN")" @bind-value="@SearchValue" @bind-onlyActive="NurAktive" />
            <MudSpacer />
            <ItreeButton Type="EnumButton.Neu" OnClick="@(() => SelectItem(new CpvNummer()))" />
        </GridToolBarTemplate>
        <GridColumns>
            <ItreeGridColumn Field="NummerStr" Title="@TranslationHelper.Translate("STAMMDATEN_CPVNUMMER_NUMMERSTR")" />
            <ItreeGridColumn Field="Bezeichnung" Title="@TranslationHelper.Translate("STAMMDATEN_CPVNUMMER_BEZEICHNUNG")" />
            <ItreeGridColumn Field="Nummer" Title="@TranslationHelper.Translate("STAMMDATEN_CPVNUMMER_NUMMER")" />
            <ItreeGridColumn Field="Aktiv" Title="@TranslationHelper.Translate("STAMMDATEN_CPVNUMMER_AKTIV")">
                <Template>
                    <JaNeinIcon Wert="context.Aktiv" />
                </Template>
            </ItreeGridColumn>
            <ItreeGridColumn Sortable="false" Filterable="false">
                <Template>
                    @if (OnSelect.HasDelegate)
                    {
                        <div class="btn-group-grid">
                            <ItreeButton Type="EnumButton.Hinzufuegen" OnClick="@(() => OnItemSelected(context))" ShowButtonText="false" />
                        </div>
                    }
                </Template>
            </ItreeGridColumn>
        </GridColumns>
    </ItreeGrid>

    <ItreeFormWindow WindowVisible="@(SelectedItem != null)"
                     WindowWidth="800px"
                     Model="@SelectedItem"
                     OnSave="@Save"
                     Validator="@Validator"
                     AutoGenerate="true"
                     WithBaseProperties="true"
                     IgnorePropertyList="@BasisfelderAusgeblendet"
                     PrefixTranslationKey="STAMMDATEN_CPVNUMMER"
                     OnClose="@Cancel"
                     OnDelete="Delete"
                     DeleteButtonShow="true" />
}

@code {
    /// <summary>Ids, die in der Auswahl nicht mehr angeboten werden (bereits zugeordnete Nummern).</summary>
    [Parameter]
    public IEnumerable<Guid>? ExcludeIds { get; set; }

    private IEnumerable<CpvNummer> FilteredList =>
        ExcludeIds == null ? DataList! : DataList!.Where(d => !ExcludeIds.Contains(d.Id));

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Validator = new CpvNummerValidator(true);
    }

    /// <summary>Im Auswahlmodus (OnSelect gesetzt) öffnet der Zeilenklick kein Editierfenster.</summary>
    private async Task OnRowClick(ItreeGridRowClickEventArgs args)
    {
        if (OnSelect.HasDelegate)
        {
            return;
        }

        await SelectItem(args);
    }

    private async Task OnItemSelected(CpvNummer item)
    {
        if (!OnSelect.HasDelegate)
        {
            throw new InvalidOperationException("Missing 'OnSelect' Event");
        }

        await OnSelect.InvokeAsync(item);
    }
}
