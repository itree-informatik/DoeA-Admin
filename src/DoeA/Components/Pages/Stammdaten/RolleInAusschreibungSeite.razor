@using DoeA.Data.Models.DTO.Stammdaten
@using DoeA.Validator.Stammdaten
@using DoeA.Interfaces.Stammdaten

@inherits EditComponent<RolleInAusschreibung, IRolleInAusschreibungService>

@if (DataList == null)
{
    <ItreeSpinner />
}
else
{
    <ItreeGrid TItem="RolleInAusschreibung" Data="DataList"
               Sortable="true" FilterMode="ItreeGridFilterMode.FilterMenu" OnRowClick="@SelectItem">
        <GridToolBarTemplate>
            @* Ohne Aktiv (Formular, Spalte, Schalter): Die Einträge sind über ihre NaturalId applikationsrelevant
               (Bau-Vorbelegung, Auswertungen) — sie bleiben immer aktiv. *@
            <ItreeSearchbox Id="searchbox" OnClick="@LoadData" Placeholder="@TranslationHelper.Translate("AUSWAEHLEN")" @bind-value="@SearchValue" HideOnlyActive="true" />
        </GridToolBarTemplate>
        <GridColumns>
            <ItreeGridColumn Field="Bezeichnung" Title="@TranslationHelper.Translate("STAMMDATEN_ROLLEINAUSSCHREIBUNG_BEZEICHNUNG")" />
            <ItreeGridColumn Field="Kurzbezeichnung" Title="@TranslationHelper.Translate("STAMMDATEN_ROLLEINAUSSCHREIBUNG_KURZBEZEICHNUNG")" />
        </GridColumns>
    </ItreeGrid>

    <ItreeFormWindow WindowVisible="@(SelectedItem != null)"
                     WindowWidth="800px"
                     Model="@SelectedItem"
                     OnSave="@Save"
                     Validator="@Validator"
                     AutoGenerate="true"
                     PrefixTranslationKey="STAMMDATEN_ROLLEINAUSSCHREIBUNG"
                     OnClose="@Cancel" />
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Validator = new RolleInAusschreibungValidator(true);
    }
}
