@using DoeA.Data.Models.DTO.Stammdaten
@using DoeA.Validator.Stammdaten
@using DoeA.Interfaces.Stammdaten

@inherits EditComponent<Offertezustand, IOffertezustandService>

@if (DataList == null)
{
    <ItreeSpinner />
}
else
{
    <ItreeGrid TItem="Offertezustand" Data="DataList"
               Sortable="true" FilterMode="ItreeGridFilterMode.FilterMenu" OnRowClick="@SelectItem">
        <GridToolBarTemplate>
            @* Bewusst ohne Neu- und Löschen-Aktion und ohne Aktiv (Formular, Spalte, Schalter): Die Zustände sind über ihre NaturalId
               applikationsrelevant (Abschluss-/Abbruchlogik der Lose) — der Bestand ist fix und immer aktiv. *@
            <ItreeSearchbox Id="searchbox" OnClick="@LoadData" Placeholder="@TranslationHelper.Translate("AUSWAEHLEN")" @bind-value="@SearchValue" HideOnlyActive="true" />
        </GridToolBarTemplate>
        <GridColumns>
            <ItreeGridColumn Field="Bezeichnung" Title="@TranslationHelper.Translate("STAMMDATEN_OFFERTEZUSTAND_BEZEICHNUNG")" />
            <ItreeGridColumn Field="Kurzbezeichnung" Title="@TranslationHelper.Translate("STAMMDATEN_OFFERTEZUSTAND_KURZBEZEICHNUNG")" />
            <ItreeGridColumn Field="Schlusszustand" Title="@TranslationHelper.Translate("STAMMDATEN_OFFERTEZUSTAND_SCHLUSSZUSTAND")">
                <Template>
                    <JaNeinIcon Wert="context.Schlusszustand" />
                </Template>
            </ItreeGridColumn>
            <ItreeGridColumn Field="Publikation" Title="@TranslationHelper.Translate("STAMMDATEN_OFFERTEZUSTAND_PUBLIKATION")">
                <Template>
                    <JaNeinIcon Wert="context.Publikation" />
                </Template>
            </ItreeGridColumn>
        </GridColumns>
    </ItreeGrid>

    <ItreeFormWindow WindowVisible="@(SelectedItem != null)"
                     WindowWidth="800px"
                     Model="@SelectedItem"
                     OnSave="@Save"
                     Validator="@Validator"
                     AutoGenerate="true"
                     PrefixTranslationKey="STAMMDATEN_OFFERTEZUSTAND"
                     OnClose="@Cancel" />
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Validator = new OffertezustandValidator(true);
    }
}
