@using DoeA.Data.Models.DTO.Stammdaten
@using DoeA.Validator.Stammdaten
@using DoeA.Interfaces.Stammdaten
@inherits EditComponent<Verfahrensschritt, IVerfahrensschrittService>

@if (DataList == null)
{
    <ItreeSpinner />
}
else
{
    <ItreeGrid TItem="Verfahrensschritt" Data="DataList" Pageable="true" PageSize="@PageSize" PageSizes="@PageSizeOptions"
               Sortable="true" FilterMode="ItreeGridFilterMode.FilterMenu" OnRowClick="@SelectItem">
        <GridToolBarTemplate>
            <ItreeSearchbox Id="searchbox" OnClick="@LoadData" Placeholder="@TranslationHelper.Translate("AUSWAEHLEN")" @bind-value="@SearchValue" @bind-onlyActive="NurAktive" />
            <MudSpacer />
            <ItreeButton Type="EnumButton.Neu" OnClick="@(() => SelectItem(new Verfahrensschritt()))" />
        </GridToolBarTemplate>
        <GridColumns>
            <ItreeGridColumn Field="Bezeichnung" Title="@TranslationHelper.Translate("STAMMDATEN_VERFAHRENSSCHRITT_BEZEICHNUNG")" />
            <ItreeGridColumn Field="Sortierung" Title="@TranslationHelper.Translate("STAMMDATEN_VERFAHRENSSCHRITT_SORTIERUNG")" />
            <ItreeGridColumn Field="NurWerktage" Title="@TranslationHelper.Translate("STAMMDATEN_VERFAHRENSSCHRITT_NURWERKTAGE")">
                <Template>
                    <JaNeinIcon Wert="context.NurWerktage" />
                </Template>
            </ItreeGridColumn>
            <ItreeGridColumn Field="Offen" Title="@TranslationHelper.Translate("STAMMDATEN_VERFAHRENSSCHRITT_OFFEN")">
                <Template>
                    <JaNeinIcon Wert="context.Offen" />
                </Template>
            </ItreeGridColumn>
            <ItreeGridColumn Field="Selektiv" Title="@TranslationHelper.Translate("STAMMDATEN_VERFAHRENSSCHRITT_SELEKTIV")">
                <Template>
                    <JaNeinIcon Wert="context.Selektiv" />
                </Template>
            </ItreeGridColumn>
            <ItreeGridColumn Field="Aktiv" Title="@TranslationHelper.Translate("STAMMDATEN_VERFAHRENSSCHRITT_AKTIV")">
                <Template>
                    <JaNeinIcon Wert="context.Aktiv" />
                </Template>
            </ItreeGridColumn>
        </GridColumns>
    </ItreeGrid>

    <ItreeFormWindow WindowVisible="@(SelectedItem != null)"
                     WindowWidth="800px"
                     Model="@SelectedItem"
                     OnSave="@Save"
                     Validator="@Validator"
                     AutoGenerate="true"
                     WithBaseProperties="true"
                     IgnorePropertyList="@BasisfelderAusgeblendet"
                     PrefixTranslationKey="STAMMDATEN_VERFAHRENSSCHRITT"
                     OnClose="@Cancel"
                     OnDelete="Delete"
                     DeleteButtonShow="true" />
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Validator = new VerfahrensschrittValidator(true);
    }
}
